# Copy to .env.local and fill in. .env.local is gitignored (matches *.local).
# Vite exposes only VITE_-prefixed variables to the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Canonical public origin, no path. Change when using a custom domain.
VITE_SITE_URL=https://www.oragontradingplc.com
